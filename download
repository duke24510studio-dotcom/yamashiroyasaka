:root {
  color-scheme: light;
  --bg: #f4f6f2;
  --panel: #ffffff;
  --ink: #17201c;
  --muted: #68726d;
  --line: #dce2dd;
  --accent: #0f7b63;
  --accent-dark: #095643;
  --warning: #c0572a;
  --shadow: 0 18px 45px rgba(26, 38, 33, 0.12);
}

.theme-violations {
  --bg: #f6f1ea;
  --panel: #fffdf9;
  --ink: #241d18;
  --muted: #786b61;
  --line: #e6d9cc;
  --accent: #9a4f1f;
  --accent-dark: #65310f;
  --warning: #b21f38;
  --shadow: 0 18px 42px rgba(64, 42, 24, 0.12);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: "BIZ UDPGothic", "Yu Gothic UI", "Segoe UI", "Hiragino Kaku Gothic ProN", Meiryo, sans-serif;
  line-height: 1.5;
}

button,
input,
select,
textarea {
  font: inherit;
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px clamp(16px, 4vw, 44px);
  background: var(--accent-dark);
  color: #fff;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 22px;
  min-width: 0;
}

.brand-logo-frame {
  width: clamp(360px, 58vw, 989px);
  height: 285px;
  border-radius: 6px;
  background: #fff;
  display: block;
  flex: 0 0 auto;
  overflow: hidden;
  position: relative;
}

.brand-logo {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center 49%;
  transform: scale(1.12);
  transform-origin: center;
}

.eyebrow {
  margin: 0 0 4px;
  color: color-mix(in srgb, #fff 72%, var(--accent));
  font-size: 0.82rem;
  font-weight: 700;
}

h1,
h2,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 0;
  font-size: clamp(1.4rem, 3vw, 2.2rem);
  letter-spacing: 0;
}

h2 {
  margin-bottom: 12px;
  font-size: 1rem;
}

.header-actions,
.app-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.file-button,
button,
.app-nav a {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 6px;
  background: var(--accent);
  color: #fff;
  cursor: pointer;
  font-weight: 700;
  padding: 0 14px;
  text-decoration: none;
}

.file-button input {
  display: none;
}

.app-nav {
  overflow-x: auto;
  border-bottom: 1px solid var(--line);
  background: color-mix(in srgb, var(--panel) 86%, var(--bg));
  padding: 10px clamp(12px, 3vw, 32px);
}

.app-nav a {
  border-color: var(--line);
  background: var(--panel);
  color: var(--ink);
  font-size: 0.9rem;
  white-space: nowrap;
}

.app-nav a.is-active {
  border-color: var(--accent);
  background: var(--accent);
  color: #fff;
}

.dashboard {
  display: grid;
  gap: 18px;
  padding: 18px clamp(12px, 3vw, 32px) 32px;
}

.data-source,
.filters,
.table-panel,
.insight-panel,
.map-panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 8px;
  box-shadow: var(--shadow);
}

.data-source {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 16px;
}

.data-source span,
.summary span {
  color: var(--muted);
  display: block;
  font-size: 0.78rem;
  font-weight: 700;
}

.data-source strong {
  display: block;
  margin-top: 3px;
}

.data-source p {
  color: var(--muted);
  margin: 0;
  text-align: right;
}

.filters {
  padding: 16px;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(120px, 1fr)) minmax(220px, 1.4fr);
  gap: 12px;
}

label {
  display: grid;
  gap: 6px;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 700;
}

select,
input[type="search"] {
  width: 100%;
  min-height: 42px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: #fff;
  color: var(--ink);
  padding: 0 10px;
}

.summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.summary article {
  min-height: 88px;
  border-left: 5px solid var(--accent);
  border-radius: 8px;
  background: var(--panel);
  box-shadow: var(--shadow);
  padding: 16px;
}

.summary strong {
  display: block;
  margin-top: 8px;
  font-size: clamp(1.2rem, 2vw, 1.8rem);
}

.workspace {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(320px, 0.85fr);
  gap: 18px;
  align-items: stretch;
}

.map-panel {
  overflow: hidden;
  min-height: 560px;
}

#map {
  width: 100%;
  height: 100%;
  min-height: 560px;
}

.maplibregl-popup-content {
  border-radius: 8px;
  box-shadow: 0 10px 28px rgba(23, 32, 28, 0.2);
  color: var(--ink);
  font-family: inherit;
}

.popup-meta {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 3px 8px;
  margin: 8px 0 0;
}

.popup-meta dt {
  color: var(--muted);
  font-weight: 700;
}

.popup-meta dd {
  margin: 0;
}

.insight-panel {
  display: grid;
  align-content: start;
  gap: 18px;
  padding: 18px;
}

.bar-list {
  display: grid;
  gap: 8px;
  color: var(--muted);
  font-size: 0.9rem;
}

.bar-row {
  display: grid;
  grid-template-columns: minmax(92px, 1fr) minmax(90px, 1.3fr) 32px;
  gap: 8px;
  align-items: center;
}

.bar-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-track {
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: color-mix(in srgb, var(--accent) 12%, #fff);
}

.bar-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, #e8c65a));
}

.bar-row strong {
  color: var(--ink);
  text-align: right;
}

.prevention-list {
  display: grid;
  gap: 10px;
  margin: 0;
  padding-left: 18px;
}

.prevention-list li::marker {
  color: var(--warning);
}

.table-panel {
  overflow: hidden;
}

.table-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 18px 0;
}

.table-heading p {
  color: var(--muted);
  font-size: 0.9rem;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  min-width: 880px;
  border-collapse: collapse;
}

th,
td {
  border-top: 1px solid var(--line);
  padding: 12px 14px;
  text-align: left;
  vertical-align: top;
}

th {
  background: color-mix(in srgb, var(--panel) 80%, var(--bg));
  color: var(--muted);
  font-size: 0.78rem;
}

tbody tr {
  cursor: pointer;
}

tbody tr:hover,
tbody tr.is-selected {
  background: color-mix(in srgb, var(--accent) 12%, #fff);
}

@media (max-width: 980px) {
  .app-header,
  .data-source,
  .table-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .brand-lockup {
    align-items: flex-start;
    flex-direction: column;
  }

  .brand-logo-frame {
    width: min(92vw, 598px);
    height: 202px;
  }

  .data-source p {
    text-align: left;
  }

  .filter-grid,
  .summary,
  .workspace {
    grid-template-columns: 1fr;
  }

  .map-panel,
  #map {
    min-height: 420px;
  }
}

@media (max-width: 600px) {
  .dashboard {
    padding-inline: 10px;
  }

  .filters,
  .insight-panel {
    padding: 12px;
  }

  .summary article {
    min-height: auto;
  }

  .bar-row {
    grid-template-columns: minmax(72px, 1fr) minmax(80px, 1fr) 28px;
  }
}

@media print {
  body {
    background: #fff;
    color: #000;
  }

  .header-actions,
  .app-nav {
    display: none !important;
  }

  .dashboard {
    display: block;
    padding: 0;
  }

  .summary,
  .workspace {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 12px 0;
  }

  .data-source,
  .filters,
  .table-panel,
  .insight-panel,
  .map-panel,
  .summary article {
    break-inside: avoid;
    border: 1px solid #aaa;
    box-shadow: none;
  }

  table {
    min-width: 0;
    font-size: 0.78rem;
  }

  th,
  td {
    padding: 6px;
  }
}
